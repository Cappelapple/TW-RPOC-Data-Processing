class MultiPolygonDrawer:
    def __init__(self, img, filename):
        self.img = img
        self.filename = filename
        self.completed_polygons = []
        self.current_polygon = []

        self.fig, self.ax = plt.subplots(figsize=(11, 8))
        self.ax.imshow(img, cmap="gray" if len(img.shape) == 2 else None)

        # Draw quadrant grid lines
        h, w = img.shape[:2]
        self.ax.axvline(x=w // 2, color="cyan", linestyle="--", linewidth=1.5)
        self.ax.axhline(y=h // 2, color="cyan", linestyle="--", linewidth=1.5)

        self.ax.set_title(
            f"Image: {filename}\n"
            "• Left-click: Add vertex | Right-click: Close polygon\n"
            "• Press 'n': Start new polygon | Close window when finished with image"
        )

        # Plot line handles for active and finalized shapes
        (self.active_line,) = self.ax.plot([], [], "ro-", linewidth=1.5, markersize=4)

        # Connect click and key events
        self.fig.canvas.mpl_connect("button_press_event", self.on_click)
        self.fig.canvas.mpl_connect("key_press_event", self.on_key)

        plt.show()

    def on_click(self, event):
        if event.inaxes != self.ax:
            return

        # Left-click: Add point to active polygon
        if event.button == 1:
            self.current_polygon.append((event.xdata, event.ydata))
            x_coords = [p[0] for p in self.current_polygon]
            y_coords = [p[1] for p in self.current_polygon]
            self.active_line.set_data(x_coords, y_coords)
            self.fig.canvas.draw()

        # Right-click: Finalize current polygon
        elif event.button == 3 and len(self.current_polygon) >= 3:
            self.finalize_current_polygon()

    def on_key(self, event):
        if event.key == "n" and len(self.current_polygon) >= 3:
            self.finalize_current_polygon()

    def finalize_current_polygon(self):
        # Freeze and draw completed polygon outline
        pts = np.array(self.current_polygon)
        self.completed_polygons.append(pts)

        # Plot permanent polygon on plot
        closed_pts = np.vstack([pts, pts[0]])
        self.ax.plot(closed_pts[:, 0], closed_pts[:, 1], "g-", linewidth=2)

        # Clear active line state for the next shape
        self.current_polygon = []
        self.active_line.set_data([], [])
        self.fig.canvas.draw()
        print(f"  -> Finalized Polygon #{len(self.completed_polygons)} ({len(pts)} vertices)")


def create_polygon_mask(img_shape, polygons):
    h, w = img_shape[:2]
    mask = np.zeros((h, w), dtype=np.uint8)

    if not polygons:
        return mask

    x, y = np.meshgrid(np.arange(w), np.arange(h))
    points = np.vstack((x.flatten(), y.flatten())).T
    combined_mask_flat = np.zeros(points.shape[0], dtype=bool)

    for verts in polygons:
        path = Path(verts)
        grid_mask = path.contains_points(points)
        combined_mask_flat = np.logical_or(combined_mask_flat, grid_mask)

    return combined_mask_flat.reshape((h, w)).astype(np.uint8) * 255


def split_into_quadrants(matrix):
    h, w = matrix.shape[:2]
    mid_h, mid_w = h // 2, w // 2
    return {
        "Q1_TopLeft": matrix[0:mid_h, 0:mid_w],
        "Q2_TopRight": matrix[0:mid_h, mid_w:w],
        "Q3_BottomLeft": matrix[mid_h:h, 0:mid_w],
        "Q4_BottomRight": matrix[mid_h:h, mid_w:w],
    }


def run_multi_polygon_quadrant_analysis(input_dir, output_dir):
    os.makedirs(output_dir, exist_ok=True)

    extensions = ("*.tif", "*.tiff", "*.png", "*.jpg")
    image_files = []
    for ext in extensions:
        image_files.extend([f for f in glob.glob(os.path.join(input_dir, ext)) if "output" not in f])

    if not image_files:
        print(f"No image files found in {input_dir}")
        return

    records = []

    print("==================================================================")
    print("MULTI-POLYGON SELECTION CONTROLS:")
    print("1. Left-click to add points around an ROI.")
    print("2. Right-click (or press 'n') to CLOSE the current polygon.")
    print("3. Repeat to draw as many polygons as needed.")
    print("4. Close the window when finished with the current image.")
    print("==================================================================\n")

    for img_path in image_files:
        filename = os.path.basename(img_path)
        base_name = os.path.splitext(filename)[0]

        img = cv2.imread(img_path, cv2.IMREAD_COLOR)
        if img is None:
            continue

        drawer = MultiPolygonDrawer(img, filename)

        # Build combined binary mask from all drawn polygons
        full_mask = create_polygon_mask(img.shape, drawer.completed_polygons)
        cv2.imwrite(os.path.join(output_dir, f"{base_name}_full_polygon_mask.png"), full_mask)

        # Split mask into 4 quadrants
        quad_masks = split_into_quadrants(full_mask)

        is_treated = "treated" in base_name.lower() and "untreated" not in base_name.lower()
        condition = "Treated" if is_treated else "Untreated"

        # Record metrics for each quadrant
        for quad_key, q_mask in quad_masks.items():
            cv2.imwrite(os.path.join(output_dir, f"{base_name}_{quad_key}_mask.png"), q_mask)

            selected_px = cv2.countNonZero(q_mask)
            total_px = q_mask.size
            cov_pct = (selected_px / total_px) * 100

            records.append({
                "Image Name": filename,
                "Condition": condition,
                "Region": quad_key,
                "Polygons Drawn": len(drawer.completed_polygons),
                "Selected Area (Pixels)": selected_px,
                "Quadrant Total (Pixels)": total_px,
                "Area Coverage (%)": round(cov_pct, 3),
            })

        # Record total image metrics
        full_selected = cv2.countNonZero(full_mask)
        full_total = full_mask.size
        records.append({
            "Image Name": filename,
            "Condition": condition,
            "Region": "Full Image Total",
            "Polygons Drawn": len(drawer.completed_polygons),
            "Selected Area (Pixels)": full_selected,
            "Quadrant Total (Pixels)": full_total,
            "Area Coverage (%)": round((full_selected / full_total) * 100, 3),
        })

    df = pd.DataFrame(records)
    csv_path = os.path.join(output_dir, "multi_polygon_quadrant_summary.csv")
    df.to_csv(csv_path, index=False)

    print("\n==================================================================")
    print("--- MULTI-POLYGON QUADRANT RESULTS ---")
    print("==================================================================")
    print(df.to_string(index=False))

    # Calculate overall Inhibition Efficiency
    untreated_df = df[(df["Condition"] == "Untreated") & (df["Region"] == "Full Image Total")]
    treated_df = df[(df["Condition"] == "Treated") & (df["Region"] == "Full Image Total")]

    if not untreated_df.empty and not treated_df.empty:
        u_mean = untreated_df["Area Coverage (%)"].mean()
        t_mean = treated_df["Area Coverage (%)"].mean()
        inh_eff = (1.0 - (t_mean / u_mean)) * 100 if u_mean > 0 else 0.0

        print("\n==================================================================")
        print(f"Mean Untreated Coverage: {u_mean:.3f}%")
        print(f"Mean Treated Coverage:   {t_mean:.3f}%")
        print(f"--> Final Inhibition Efficiency: {inh_eff:.2f}%")
        print("==================================================================\n")

    print(f"Results and cropped quadrant masks saved to:\n{output_dir}")


if __name__ == "__main__":
    run_multi_polygon_quadrant_analysis(DATA_DIR, OUTPUT_DIR)
    