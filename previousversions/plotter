import os  # <-- ADD THIS LINE AT THE VERY TOP
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

def generate_global_comparison_plots():
    if not os.path.exists("master_kinetics_summary.csv"):
        print("No master data file found. Run the tracer script on a few datasets first!")
        return
        
    df = pd.read_csv("master_kinetics_summary.csv")
    
    # Isolate only the Treated Cell kinetics for true comparative profiling
    treated_df = df[df["Type"] == "Treated"]
    
    plt.figure(figsize=(10, 6))
    
    # Create a bar or point plot comparing decay rate constants across Wavelengths and Conditions
    sns.barplot(
        data=treated_df, 
        x="Wavelength", 
        y="Decay_Constant_k", 
        hue="Condition", 
        palette="muted",
        errorbar=None  # Replaced deprecated 'ci=None' to match modern seaborn standards
    )
    
    plt.title("Fluorophore Decay Constant (k) across Wavelengths & Environments")
    plt.ylabel("Decay Rate Constant (k) [s^-1]")
    plt.xlabel("Excitation Light Wavelength")
    plt.grid(True, linestyle=':', alpha=0.6)
    plt.show()

if __name__ == "__main__":
    generate_global_comparison_plots()