        self.lbl_frame_idx = QLabel("0 / 0 (0.00s)")
        frame_bar.addWidget(self.slider_frame)
        frame_bar.addWidget(self.lbl_frame_idx)
        center_layout.addLayout(frame_bar)
        
        contrast_box = QFrame()
        contrast_box.setFrameShape(QFrame.Shape.StyledPanel)
        c_layout = QVBoxLayout(contrast_box)
        c_layout.addWidget(QLabel("<b>🎨 CONTRAST & BRIGHTNESS STRETCH</b>"))
        
        min_bar = QHBoxLayout()
        min_bar.addWidget(QLabel("Black Point (Min):"))
        self.slider_min = QSlider(Qt.Orientation.Horizontal)
        self.slider_min.valueChanged.connect(self.update_image_display)
        min_bar.addWidget(self.slider_min)
        c_layout.addLayout(min_bar)
        
        max_bar = QHBoxLayout()
        max_bar.addWidget(QLabel("White Point (Max):"))
        self.slider_max = QSlider(Qt.Orientation.Horizontal)
        self.slider_max.valueChanged.connect(self.update_image_display)
        max_bar.addWidget(self.slider_max)
        c_layout.addLayout(max_bar)
        
        btn_auto_contrast = QPushButton("✨ Auto-Stretch Contrast")
        btn_auto_contrast.clicked.connect(self.auto_stretch_contrast)
        c_layout.addWidget(btn_auto_contrast)
        
        center_layout.addWidget(contrast_box)
