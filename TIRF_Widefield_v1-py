class CappelWidefieldAnalyzer(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Cappel-Widefield - Interactive Data & Spatial Analyzer")
        self.resize(1500, 850)
        
        # State Data
        self.root_directory = r"C:\Users\calap\Box\(L2 Sensitive) zhan2017\Zhang lab data\AAppel\Widefield RPOC\2026-08-04"
        self.stack = None
        self.metadata = {}
        self.effective_fps = 87.0
        self.current_frame_idx = 0
        
        self.init_ui()
        self.scan_root_directory(self.root_directory)
        
    def init_ui(self):
        main_widget = QWidget()
        self.setCentralWidget(main_widget)
        main_layout = QHBoxLayout(main_widget)
        
        splitter = QSplitter(Qt.Orientation.Horizontal)
        main_layout.addWidget(splitter)
        
        # ================= 1. SIDEBAR DATASET BROWSER =================
        sidebar_widget = QWidget()
        sidebar_layout = QVBoxLayout(sidebar_widget)
        sidebar_layout.setContentsMargins(5, 5, 5, 5)
        
        sidebar_layout.addWidget(QLabel("<b>📁 TRIAL DATASETS</b>"))
