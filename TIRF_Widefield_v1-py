        sidebar_layout.addWidget(QLabel("<b>📋 METADATA SUMMARY</b>"))
        self.txt_metadata = QTextEdit()
        self.txt_metadata.setReadOnly(True)
        self.txt_metadata.setPlaceholderText("Select or hover over a trial to view metadata parameters...")
        self.txt_metadata.setFixedHeight(180)
        sidebar_layout.addWidget(self.txt_metadata)
        
        splitter.addWidget(sidebar_widget)
        
        # ================= 2. MIDDLE VIEWPORT & CONTROLS =================
        center_widget = QWidget()
        center_layout = QVBoxLayout(center_widget)
        
        self.lbl_trial_header = QLabel("<b>No Dataset Loaded</b>")
        center_layout.addWidget(self.lbl_trial_header)
        
        self.image_canvas = pg.GraphicsLayoutWidget()
        self.image_plot = self.image_canvas.addPlot()
        self.image_plot.setAspectLocked(True)
        self.image_plot.invertY(True)
        self.image_plot.hideAxis('left')
        self.image_plot.hideAxis('bottom')
        
        self.image_item = pg.ImageItem()
        self.image_plot.addItem(self.image_item)
        
        self.roi = pg.RectROI([100, 100], [100, 100], pen=pg.mkPen('#3aafa9', width=2))
